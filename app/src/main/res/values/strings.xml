    <string name="quick_wipe">Quick wipe</string>
    <string name="quick_wipe_desc">Clear download history, cookies, browser data, thumbnails, cache and leftover temporary files. Downloaded files are kept.</string>
    <string name="quick_wipe_confirm_title">Wipe UniFetcher\'s data?</string>
    <string name="quick_wipe_confirm_msg">This clears your download history, saved cookies and logins, built-in browser data, cached thumbnails and temporary files. It can\'t be undone.\n\nYour downloaded videos and audio stay where they are, and your settings and app lock are kept.</string>
