    <string name="temp_location">Temporary files location</string>
    <string name="temp_location_same">Same as download folder</string>
    <string name="temp_location_internal">Internal storage</string>
    <string name="temp_location_removable">SD card or USB drive</string>
    <string name="temp_free">%1$s free</string>
    <string name="temp_location_help">While a video downloads, its unfinished pieces are kept here. A long video can need several GB. If this is a different storage from your download folder, finished videos are moved across, which takes longer and briefly needs space on both. On an SD card or USB drive, UniFetcher uses its own folder (Android/data/com.unifetch.app), which needs no permission. Android deletes that folder if UniFetcher is uninstalled, which is fine for temporary files.</string>
    <string name="temp_status_internal">Now: internal storage (%1$s free)</string>
    <string name="temp_status_removable">Now: SD card or USB drive (%1$s free)</string>
    <string name="storage_pause_removed_title">SD card or USB drive removed: downloads paused</string>
    <string name="storage_pause_removed">The SD card or USB drive UniFetcher saves to isn\'t connected. Plug it back in and downloads continue by themselves.</string>
    <string name="storage_pause_no_app_folder_title">Choose where temporary files go</string>
    <string name="storage_pause_no_app_folder">This phone doesn\'t let UniFetcher keep temporary files on your SD card or USB drive. Go to Settings → Download directory → Temporary files location and choose Internal storage to continue. Finished videos still go to your drive.</string>
    <string name="storage_not_enough_for_video">Not enough space for temporary files: this video needs about %1$s, but only %2$s is free. Free up space or change the temporary files location, then tap Retry.</string>
    <string name="sdcard_copy_failed_kept">Couldn\'t copy the finished video to your SD card or USB drive (not connected or full). It\'s kept safely in UniFetcher\'s temporary folder: plug the drive back in or free space, then tap Retry.</string>
